{
  "name": "sparkengineweb",
  "version": "0.20.3",
  "engines": {
    "npm": "^10",
    "node": "^22"
  },
  "maintainers": [
    "https://github.com/RuggeroVisintin"
  ],
  "description": "",
  "types": "src/index.d.ts",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development --watch",
    "build:docs": "sh ./scripts/build-docs.sh",
    "build:lib": "sh ./scripts/build-lib.sh",
    "serve:examples": "sh ./scripts/serve-examples.sh",
    "clean": "npx tsc --build --clean",
    "test": "jest --watch",
    "test:ci": "jest --config jest.ci.config.js",
    "test:unit": "jest test/unit --config jest.config.js",
    "test:unit:ci": "jest test/unit --config jest.ci.config.js",
    "test:eslint-rules": "jest test/eslint-rules --config jest.config.js",
    "test:eslint-rules:ci": "jest test/eslint-rules --config jest.ci.config.js",
    "test:perf": "npx ts-node test/performance/bench.perf.ts",
    "test:perf:ci": "npm run test:perf -- --no-color",
    "test:visual": "npx playwright test",
    "test:visual:update-baseline": "npx playwright test --update-snapshots",
    "test:breaking-changes": "sh ./scripts/test-breaking-changes.sh",
    "postinstall": "sh ./scripts/post-install.sh",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "adr": "./vendors/adr-tools/src/adr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuggeroVisintin/SparkEngineWeb.git"
  },
  "author": "https://github.com/RuggeroVisintin",
  "license": "GNU GPL v2",
  "bugs": {
    "url": "https://github.com/RuggeroVisintin/SparkEngineWeb/issues"
  },
  "homepage": "https://github.com/RuggeroVisintin/SparkEngineWeb#readme",
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.1",
    "commitlint": "^21.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "express": "^5.3.0",
    "fastbench": "^1.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.2",
    "jest-extended": "^7.0.0",
    "make-coverage-badge": "^1.2.0",
    "release-please": "github:RuggeroVisintin/release-please",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "uuid": "^14.0.3"
  }
}
